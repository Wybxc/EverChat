{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts", "shared"],
  "exclude": [
    "scripts/operations",
    "scripts/measurements/support/*worker.ts",
    "scripts/dev/*worker.ts",
    "scripts/measurements/support/access.ts"
  ]
}
