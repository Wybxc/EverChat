{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everchat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.wybxc.cc", "custom_domain": true }],
  "vars": {
    "ACCESS_AUD": "fbe91ef41fa71985ac8aa25409f047cc0bc03cec0152cf3151333c6d71515ffd",
    "ACCESS_TEAM_DOMAIN": "wybxc.cloudflareaccess.com",
    "ACCESS_ALLOWED_EMAILS": "wybxc@qq.com",
    "APP_ORIGIN": "https://chat.wybxc.cc",
    "AI_PROVIDER": "",
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_MODEL": "",
    "SYSTEM_PROMPT": "你是一位清晰、友善的助手。请默认使用中文回答。",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "LIBRARY", "class_name": "Library" },
    ],
  },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "everchat-attachments" }],
  "workflows": [
    { "binding": "WEB_TOOLS", "name": "everchat-web-tools", "class_name": "WebToolWorkflow" },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation", "Library"] }],
  "observability": { "enabled": true },
}
