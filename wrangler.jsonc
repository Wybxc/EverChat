{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everchat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*", "/public", "/public/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  // Configure your Custom Domain and Access variables in the Cloudflare dashboard.
  // Keep deployment-specific variables when publishing from this shared config.
  "keep_vars": true,
  "vars": {
    "AI_PROVIDER": "",
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_MODEL": "",
    "SYSTEM_PROMPT": "你是一位清晰、友善的助手。请默认使用中文回答。",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "LIBRARY", "class_name": "Library" },
      { "name": "USAGE", "class_name": "UsageStore" },
      { "name": "SHARES", "class_name": "ShareStore" },
    ],
  },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "everchat-attachments" }],
  "workflows": [
    { "binding": "WEB_TOOLS", "name": "everchat-web-tools", "class_name": "WebToolWorkflow" },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conversation", "Library"] },
    { "tag": "v2-usage", "new_sqlite_classes": ["UsageStore"] },
    { "tag": "v3-sharing", "new_sqlite_classes": ["ShareStore"] },
  ],
  "observability": { "enabled": true },
}
