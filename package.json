{
  "name": "everchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "ops:storage": "node --import tsx/esm scripts/operations/storage.ts",
    "test:operations": "node --import tsx/esm --test tests/integration/operations/storage.native.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:access": "vite --host 127.0.0.1 --mode access",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.operations.json && tsc -p tsconfig.shared.json && tsc -p tsconfig.sw.json && pnpm typecheck:tests",
    "update:model-catalog": "node --import tsx/esm scripts/models/update-catalog.ts",
    "test": "node --import tsx/esm scripts/testing/run-unit.ts",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "measure:cloudflare-metrics": "node --import tsx/esm scripts/measurements/cloudflare-metrics.ts",
    "measure:cloudflare-tail": "node --import tsx/esm scripts/measurements/cloudflare-tail.ts",
    "measure:cloudflare": "node --import tsx/esm scripts/measurements/stream-cloudflare.ts",
    "measure:cloudflare-history": "node --import tsx/esm scripts/measurements/history-cloudflare.ts",
    "measure:stream": "node --import tsx/esm scripts/measurements/stream-baseline.ts",
    "measure:tools": "node --import tsx/esm scripts/measurements/tool-baseline.ts",
    "measure:cloudflare-tools": "node --import tsx/esm scripts/measurements/tools-cloudflare.ts",
    "measure:tools-platform-local": "node --import tsx/esm scripts/measurements/tool-platform-local.ts",
    "check": "pnpm test && pnpm test:operations && pnpm build && pnpm test:e2e && pnpm test:pwa",
    "typecheck:tests": "tsc -p tsconfig.tests.client.json && tsc -p tsconfig.tests.node.json && tsc -p tsconfig.tests.runtime.json && tsc -p tsconfig.tests.browser.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eventsource-parser": "^3.1.1",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reconnecting-websocket": "^4.4.0",
    "shadcn": "4.21.5",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^26.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
