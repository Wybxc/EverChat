{
  "name": "everchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "measure:cloudflare-metrics": "node --import tsx/esm scripts/cloudflare-metrics.ts",
    "measure:cloudflare-tail": "node --import tsx/esm scripts/cloudflare-tail.ts",
    "measure:cloudflare": "node --import tsx/esm scripts/stream-cloudflare.ts",
    "measure:cloudflare-history": "node --import tsx/esm scripts/history-cloudflare.ts",
    "measure:stream": "node --import tsx/esm scripts/stream-baseline.ts",
    "check": "pnpm test && pnpm build && pnpm test:e2e && pnpm test:pwa"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.1",
    "eventsource-parser": "^3.1.1",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reconnecting-websocket": "^4.4.0",
    "streamdown": "^2.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "latest",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
