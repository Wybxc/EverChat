{
  "name": "everchat",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "ops:storage": "node --import tsx/esm scripts/operations/storage.ts",
    "test:operations": "node --import tsx/esm --test tests/integration/operations/storage.native.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:access": "vite --host 127.0.0.1 --mode access",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p config/tsconfig.app.json && tsc -p config/tsconfig.worker.json && tsc -p config/tsconfig.sw.json && tsc -p config/tsconfig.tooling.json",
    "update:model-catalog": "node --import tsx/esm scripts/update-model-catalog.ts",
    "test": "node --import tsx/esm scripts/test.ts unit",
    "test:e2e": "node --import tsx/esm scripts/test.ts e2e",
    "test:pwa": "node --import tsx/esm scripts/test.ts pwa",
    "check": "pnpm test && pnpm test:operations && pnpm build && pnpm test:e2e && pnpm test:pwa",
    "measure": "node --import tsx/esm scripts/measure.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/open-responses": "2.0.63",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@ai-sdk/react": "4.0.149",
    "@ai-sdk/valibot": "3.0.63",
    "@base-ui/react": "^1.9.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@shadcn/react": "^0.3.1",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.1",
    "@valibot/to-json-schema": "1.7.1",
    "ai": "7.0.145",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "^3.1.1",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "i18next": "^26.5.2",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "match-sorter": "^8.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.0",
    "recharts": "^3.10.1",
    "reconnecting-websocket": "^4.4.0",
    "remark-breaks": "^4.0.0",
    "shadcn": "4.21.5",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "latest",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^26.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "endOfLine": "lf"
  }
}
