{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everchat-stream-validation",
  "main": "scripts/measurements/support/stream-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "AI_PROVIDER": "",
    "AI_BASE_URL": "https://provider.test/v1",
    "AI_MODEL": "",
    "SYSTEM_PROMPT": "",
    "GENERATION_METRICS": "0"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "LIBRARY", "class_name": "Library" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation", "Library"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
