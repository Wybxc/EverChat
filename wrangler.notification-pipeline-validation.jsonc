{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everchat-notification-pipeline-validation",
  "main": "scripts/measurements/support/notification-pipeline-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AI_PROVIDER": "",
    "AI_BASE_URL": "",
    "AI_MODEL": "",
    "SYSTEM_PROMPT": "",
    "GENERATION_METRICS": "0",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "NotificationProducer" },
      { "name": "LIBRARY", "class_name": "Library" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationProducer", "Library"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
