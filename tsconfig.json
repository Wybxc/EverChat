{
  "files": [],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "./config/tsconfig.app.json" },
    { "path": "./config/tsconfig.worker.json" },
    { "path": "./config/tsconfig.sw.json" },
    { "path": "./config/tsconfig.tooling.json" }
  ]
}
