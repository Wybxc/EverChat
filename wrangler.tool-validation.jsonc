{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everchat-tools-validation",
  "main": "tests/fixtures/tool-cloudflare-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "AI_PROVIDER": "",
    "AI_BASE_URL": "https://provider.test/v1",
    "AI_MODEL": "",
    "SYSTEM_PROMPT": "",
    "GENERATION_METRICS": "0",
    "LOCAL_RESOURCE_METRICS": "0",
    "LOCAL_TOOL_WORKLOAD": "{\"chunks\":120,\"size\":200,\"interval\":25}"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "LIBRARY", "class_name": "Library" }
    ]
  },
  "workflows": [{ "binding": "WEB_TOOLS", "name": "everchat-tools-validation-flow", "class_name": "WebToolWorkflow" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation", "Library"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
